MCP_SERVER_URL=https://mcp.viralizer.ai/mcp
MCP_TOOL_NAME=analyze_topic
MCP_TOPIC_ARGUMENT=keyword
MCP_HOT_TOPIC_KEYS=google,twitter,US,business,entertainment
MCP_API_KEY=replace_with_your_viralizer_key
MCP_AUTH_TOKEN=

PIXVERSE_API_KEY=replace_with_your_pixverse_key
PIXVERSE_GROWTH_API_KEY=replace_with_your_mh_live_growth_studio_key
PIXVERSE_GROWTH_BASE_URL=https://growth-api.pixverse.ai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
RUNWAYML_API_SECRET=
HEYGEN_API_KEY=

# Creatorthon social publishing
# PUBLIC_BASE_URL must be the public HTTPS Viralizer URL so Instagram can fetch the reel.
PUBLIC_BASE_URL=
META_GRAPH_VERSION=v24.0
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
FACEBOOK_PAGE_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202608

DAILY_TRENDS_ENABLED=true
DAILY_TRENDS_TIME=07:00
DAILY_CANDIDATE_LIMIT=540
DAILY_RESULT_LIMIT=20
APP_DATA_DIR=/var/data
APP_PASSWORD=change_this_password

# Permanent user workspace. Supabase: Project Settings > Database > connection string.
# Use the transaction-pooler URL when deploying on Render.
DATABASE_URL=

# Permanent generated-media storage (Cloudflare R2 S3 API credentials).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=viralizer-media
