MCP_SERVER_URL=https://mcp.viralizer.ai/mcp
MCP_TOOL_NAME=analyze_topic
MCP_TOPIC_ARGUMENT=keyword
MCP_HOT_TOPIC_KEYS=google,twitter,US,business,entertainment
MCP_API_KEY=replace_with_your_viralizer_key
MCP_AUTH_TOKEN=

PIXVERSE_API_KEY=replace_with_your_pixverse_key
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
RUNWAYML_API_SECRET=
HEYGEN_API_KEY=

DAILY_TRENDS_ENABLED=true
DAILY_TRENDS_TIME=07:00
DAILY_CANDIDATE_LIMIT=540
DAILY_RESULT_LIMIT=20
APP_DATA_DIR=/var/data
APP_PASSWORD=change_this_password
